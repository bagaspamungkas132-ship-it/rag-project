from openai import OpenAI
import os

client = OpenAI(
    base_url="<base_url yang sama>",
    api_key=os.getenv("QWEN_API_KEY")
)

for model_name in ["text-embedding-v1", "text-embedding-v2", "text-embedding-v3", "Qwen/Qwen3-Embedding"]:
    try:
        resp = client.embeddings.create(model=model_name, input="test")
        print(f"BERHASIL dengan model: {model_name}, dimensi: {len(resp.data[0].embedding)}")
    except Exception as e:
        print(f"{model_name} -> GAGAL: {e}")
