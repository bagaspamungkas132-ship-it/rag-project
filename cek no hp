norm AS (
  SELECT
    b.customerid,
    b.no_hp_procif1, b.no_hp_procif2, b.no_hp_om, b.no_hp_sics,
    coalesce(p.procif_core_set, array()) AS procif_core_set,
    coalesce(p.has_valid_procif, 0) AS has_valid_procif,
    regexp_replace(regexp_replace(coalesce(b.no_hp_om,''),'[^0-9]',''), '^(62|0)+', '') AS om_core,
    length(regexp_replace(coalesce(b.no_hp_om,''),'[^0-9]','')) AS om_len,
    regexp_replace(coalesce(b.no_hp_om,''),'[^0-9]','') RLIKE '^0+$' AS om_is_zero,        -- 🆕 kolom baru terpisah
    regexp_replace(regexp_replace(coalesce(b.no_hp_sics,''),'[^0-9]',''), '^(62|0)+', '') AS sics_core,
    length(regexp_replace(coalesce(b.no_hp_sics,''),'[^0-9]','')) AS sics_len,
    regexp_replace(coalesce(b.no_hp_sics,''),'[^0-9]','') RLIKE '^0+$' AS sics_is_zero      -- 🆕 kolom baru terpisah
  FROM base b
  LEFT JOIN procif_agg p ON b.customerid = p.customerid
),

flagged AS (
  SELECT
    customerid,
    no_hp_procif1, no_hp_procif2, no_hp_om, no_hp_sics,

    CASE
      WHEN sics_len <= 5 OR sics_is_zero OR has_valid_procif = 0 THEN NULL
      WHEN array_contains(procif_core_set, sics_core) THEN NULL
      ELSE 'SICS<>Pro'
    END AS flag1,

    CASE
      WHEN om_len <= 5 OR om_is_zero OR sics_len <= 5 OR sics_is_zero THEN NULL
      WHEN om_core = sics_core THEN NULL
      ELSE 'OM<>SICS'
    END AS flag2,

    CASE
      WHEN om_len <= 5 OR om_is_zero OR has_valid_procif = 0 THEN NULL
      WHEN array_contains(procif_core_set, om_core) THEN NULL
      ELSE 'OM<>Pro'
    END AS flag3

  FROM norm
)