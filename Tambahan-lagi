WITH normalized AS (
  SELECT 
    n.customerid,
    n.customername,
    s.dataid AS screening_id,
    s.name AS screening_name,
    concat_ws(' ', sort_array(split(lower(trim(n.customername)), ' '))) AS nasabah_sorted,
    concat_ws(' ', sort_array(split(lower(trim(s.name)), ' '))) AS screening_sorted,
    split(lower(trim(n.customername)), ' ') AS nasabah_tokens,
    split(lower(trim(s.name)), ' ') AS screening_tokens
  FROM t2_omd_pv_conf.profile_sus_acc n
  CROSS JOIN t2_omd_pv_conf.tmp_screeninglist s
),
token_match AS (
  -- pengganti array_intersect (tidak ada di Hive)
  SELECT 
    nm.customerid,
    nm.screening_id,
    COUNT(DISTINCT token) AS intersect_count
  FROM normalized nm
  LATERAL VIEW explode(nm.nasabah_tokens) t AS token
  WHERE array_contains(nm.screening_tokens, token)
  GROUP BY nm.customerid, nm.screening_id
),
scored AS (
  SELECT
    nm.customerid,
    nm.customername,
    nm.screening_name,
    1 - (levenshtein(nm.nasabah_sorted, nm.screening_sorted) * 1.0 /
         greatest(length(nm.nasabah_sorted), length(nm.screening_sorted))) AS similarity_score,
    -- Jaccard: intersect / union, union dihitung matematis (pengganti array_union)
    COALESCE(tm.intersect_count, 0) * 1.0 /
      (size(nm.nasabah_tokens) + size(nm.screening_tokens) - COALESCE(tm.intersect_count, 0)) AS jaccard_score
  FROM normalized nm
  LEFT JOIN token_match tm
    ON nm.customerid = tm.customerid AND nm.screening_id = tm.screening_id
),
ranked AS (
  SELECT 
    *,
    greatest(similarity_score, jaccard_score) AS best_score,
    ROW_NUMBER() OVER (
      PARTITION BY customerid 
      ORDER BY greatest(similarity_score, jaccard_score) DESC
    ) AS rn
  FROM scored
)
SELECT 
  customerid,
  customername,
  screening_name,
  best_score
FROM ranked
WHERE rn = 1
  AND best_score >= 0.85
ORDER BY best_score DESC;