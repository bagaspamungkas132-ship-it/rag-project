WITH base AS (
  SELECT 
    n.nasabah_id,
    n.nama_nasabah,
    s.dataid AS screening_id,
    s.nama_screening,
    concat_ws(' ', sort_array(split(lower(trim(n.nama_nasabah)), ' '))) AS nasabah_sorted,
    concat_ws(' ', sort_array(split(lower(trim(s.nama_screening)), ' '))) AS screening_sorted,
    split(lower(trim(n.nama_nasabah)), ' ') AS nasabah_tokens,
    split(lower(trim(s.nama_screening)), ' ') AS screening_tokens
  FROM nasabah n
  CROSS JOIN screening_list s
),
token_match AS (
  -- hitung intersection token pengganti array_intersect
  SELECT 
    b.nasabah_id,
    b.screening_id,
    COUNT(DISTINCT token) AS intersect_count
  FROM base b
  LATERAL VIEW explode(b.nasabah_tokens) t AS token
  WHERE array_contains(b.screening_tokens, token)
  GROUP BY b.nasabah_id, b.screening_id
),
scored AS (
  SELECT
    b.nasabah_id,
    b.nama_nasabah,
    b.nama_screening,
    1 - (levenshtein(b.nasabah_sorted, b.screening_sorted) * 1.0 /
         greatest(length(b.nasabah_sorted), length(b.screening_sorted))) AS similarity_score,
    -- Jaccard: intersect / union, union dihitung matematis (bukan array_union)
    COALESCE(tm.intersect_count, 0) * 1.0 /
      (size(b.nasabah_tokens) + size(b.screening_tokens) - COALESCE(tm.intersect_count, 0)) AS jaccard_score
  FROM base b
  LEFT JOIN token_match tm
    ON b.nasabah_id = tm.nasabah_id AND b.screening_id = tm.screening_id
),
ranked AS (
  SELECT 
    *,
    greatest(similarity_score, jaccard_score) AS best_score,
    ROW_NUMBER() OVER (
      PARTITION BY nasabah_id 
      ORDER BY greatest(similarity_score, jaccard_score) DESC
    ) AS rn
  FROM scored
)
SELECT 
  nasabah_id,
  nama_nasabah,
  nama_screening,
  best_score
FROM ranked
WHERE rn = 1
  AND best_score >= 0.85
ORDER BY best_score DESC;